{
  "maintainer": "kiranNukal",
  "package_name": "bsdiff4",
  "github_url": "https://github.com/ilanschnell/bsdiff4",
  "version": "1.2.6",
  "default_branch": "master",
  "docker_cmd": "docker build -t ${package_name}:$PACKAGE_VERSION ${dir}",
  "package_dir": "b/bsdiff4",
  "build_script": "bsdiff4.sh",
  "wheel_build": true,
  "validate_build_script": "true",
  "use_non_root_user": "false",
  "docker_build": "true",
  "v2-enabled": true,
  "*": {
    "build_script": "bsdiff4.sh"
  }
}
