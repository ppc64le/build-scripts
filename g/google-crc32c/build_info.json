{
  "maintainer": "aastha-sharma2",
  "package_name": "google-crc32c",
  "github_url": "https://github.com/googleapis/python-crc32c",
  "version": "v1.8.0",
  "language": "Python",
  "default_branch": "main",
  "package_dir": "g/google-crc32c",
  "build_script": "google-crc32c.sh",
  "validate_build_script": "true",
  "use_non_root_user": "false",
  "wheel_build": true,
  "docker_build": "false",
  "v2-enabled": true,
  "build_deps": ["crc32c-google:1.1.2"],
  "*": {
    "build_script": "google-crc32c.sh",
    "build_deps": ["crc32c-google:1.1.2"]
  }
}
