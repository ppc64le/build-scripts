+ jts                     = "1.15.0"
+-jackson_annotations     = "2.21"
+-jackson                 = "2.21.3"
+-jackson_databind        = "2.21.3"
+-jackson3                = "3.1.3"
+-jackson3_databind       = "3.1.3"
++jackson_annotations     = "2.22"
++jackson                 = "2.22.1"
++jackson_databind        = "2.22.1"
++jackson3                = "3.2.1"
++jackson3_databind       = "3.2.1"
+ snakeyaml               = "2.6"
+ snakeyaml_engine        = "3.0.1"
+ icu4j                   = "77.1"
+@@ -40,7 +40,7 @@ json_smart              = "2.5.2"
+ # when updating the JNA version, also update the version in buildSrc/build.gradle
+ jna               = "5.16.0"
+ 
+-netty             = "4.2.15.Final"
++netty             = "4.2.16.Final"
+ joda              = "2.12.7"
+ roaringbitmap     = "1.3.0"
+ 
+@@ -50,7 +50,7 @@ reactor           = "3.8.5"
+ 
+ # client dependencies
+ httpclient5       = "5.6.1"
+-httpcore5         = "5.4"
++httpcore5         = "5.4.3"
+ httpclient        = "4.5.14"
+ httpcore          = "4.4.16"
+ httpasyncclient   = "4.1.5"
+-- 
