FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Set working directory
WORKDIR /opensearch-build

# CVE mitigations: upgrade all packages with known fixes before installing anything else.
# Addresses:
#   openssl/openssl-libs  3.5.8-1.el9_8  → CVE-2026-14456 (QUIC DoS, CVSS 7.5)
#   curl-minimal/libcurl-minimal 7.76.1-40.el9_8.7 → CVE-2026-8458 (CVSS 8.1), CVE-2026-8927 (CVSS 7.5)
#   libevent 2.1.13-1.el9_8  → CVE-2026-63382..63388 (6 HIGH CVEs incl. heap OOB write CVSS 8.4)
#   libxml2 2.9.13-14.el9_8.5 → CVE-2026-74860 (CVSS 8.5), CVE-2026-86140 (CVSS 7.8)
#   expat 2.5.0-6.el9_8.5    → CVE-2026-66046 (CVSS 7.5), CVE-2026-93990 (CVSS 7.5)
#   webkit2gtk3-jsc 2.54.0-1.el9_8 → 7 CRITICAL + 8 HIGH CVEs (Skia use-after-free etc.)
#   gstreamer1-plugins-base 1.22.12-8.el9_8.2 → CVE-2026-18297 (RCE via OGG, CVSS 7.8)
#   gdb-gdbserver 16.3-3.1.el9_8 → CVE-2026-13732 (OOB write, CVSS 7.0)
# Remove packages not required in a build environment that carry unfixable CVEs:
#   flatpak / flatpak-session-helper → 5 HIGH CVEs (CVE-2026-96275 CVSS 8.8 etc.)
#   bubblewrap                       → CVE-2026-87766 (symlink traversal, CVSS 8.8)
#   xdg-dbus-proxy                   → CVE-2026-94422 (D-Bus sandbox escape, CVSS 8.8)
#   bluez-libs                       → 3 HIGH CVEs incl. CVE-2026-19774 (adj-network RCE, CVSS 8.0)
#   mesa packages                    → CVE-2026-93599 (rustls-webpki DoS, CVSS 7.5)
# Upgrade each CVE-affected package individually so that a package not present in
# this base image (e.g. libpng, gstreamer1-plugins-base, gdb) does not cause yum
# to abort the whole transaction and silently skip the others.
RUN microdnf upgrade -y curl-minimal libcurl-minimal || true && \
    microdnf upgrade -y openssl openssl-libs && \
    microdnf upgrade -y libevent && \
    microdnf upgrade -y libxml2 && \
    microdnf upgrade -y expat && \
    microdnf upgrade -y gdb-gdbserver || true && \
    microdnf upgrade -y libpng gstreamer1-plugins-base gdb || true && \
    microdnf upgrade -y webkit2gtk3-jsc || true && \
    microdnf remove -y \
        flatpak flatpak-session-helper bubblewrap xdg-dbus-proxy \
        bluez-libs \
        mesa-libGL mesa-libEGL mesa-libgbm mesa-vulkan-drivers mesa-dri-drivers || true && \
    microdnf clean all

# Install system dependencies
# curl-minimal is pre-installed in ubi9-minimal and conflicts with the full curl package.
# It provides the curl binary and is sufficient for all download steps in this image.
RUN microdnf install -y \
    git \
    gcc \
    gcc-c++ \
    gcc-gfortran \
    make \
    patch \
    tar \
    unzip \
    zip \
    which \
    jq \
    python3 \
    python3-devel \
    python3-pip \
    bzip2-devel \
    zlib-devel \
    openssl-devel \
    libffi-devel \
    xz-devel \
    rpm-build \
    && microdnf clean all

# Install yq v4 (required by assemble scripts)
RUN curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_ppc64le" \
    -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq

# Install JDK 25 — only -devel is needed in the build environment (provides javac/jar/jlink).
# java-25-openjdk and java-25-openjdk-headless are pulled in automatically as dependencies.
# java-25-openjdk-crypto-adapter is a runtime FIPS bridge for the final container, not needed here.
RUN microdnf install -y java-25-openjdk-devel && \
    microdnf clean all

# Set Java environment
# java-25-openjdk-devel pulls in java-25-openjdk-headless; use the headless jre symlink
ENV JAVA_HOME=/usr/lib/jvm/jre-25-openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
ENV GRADLE_USER_HOME=/root/.gradle

# Pre-cache all Gradle distributions used by 3.7.0 components to avoid
# network timeouts during the build (each component's gradlew would otherwise
# download its own distribution at build time).
# Versions needed:
#   9.4.1 - OpenSearch core, ml-commons, neural-search, k-NN, index-management
#   9.5.0 - job-scheduler, security
#   9.2.0 - common-utils
RUN for version in 9.4.1 9.5.0 9.2.0; do \
        mkdir -p /root/.gradle/wrapper/dists/gradle-${version}-all && \
        curl -fsSL "https://services.gradle.org/distributions/gradle-${version}-all.zip" \
            -o /tmp/gradle-${version}-all.zip && \
        HASH=$(sha256sum /tmp/gradle-${version}-all.zip | cut -d' ' -f1) && \
        DEST="/root/.gradle/wrapper/dists/gradle-${version}-all/${HASH}" && \
        mkdir -p "${DEST}" && \
        mv /tmp/gradle-${version}-all.zip "${DEST}/gradle-${version}-all.zip" && \
        touch "${DEST}/gradle-${version}-all.zip.ok"; \
    done

# Install Maven
RUN MAVEN_URL=$(curl -s https://maven.apache.org/download.cgi \
        | grep -Eo '["\047].*.bin.tar.gz["\047]' | tr -d "\"'" | uniq | head -n 1) && \
    mkdir -p /usr/local/apache-maven && \
    curl -s "$MAVEN_URL" | tar xzf - --strip-components=1 -C /usr/local/apache-maven && \
    ln -sfn /usr/local/apache-maven/bin/mvn /usr/local/bin/mvn

# Install pipenv (pin setuptools+virtualenv to avoid packaging incompatibility with pipenv 2023.6.12)
# Also install PyYAML into the system Python so that `python3 -` inline scripts
# (e.g. the manifest-patch step in build.sh) can `import yaml` without needing
# to activate the pipenv virtualenv first.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --ignore-installed \
        "setuptools==67.8.0" \
        "virtualenv==20.24.5" \
        "pipenv==2023.6.12" \
        "PyYAML>=6.0.2"

# Copy the build repo
COPY . .

# Pre-install Python dependencies
RUN python3 -m pipenv install --deploy --ignore-pipfile

# Set default command
CMD ["/bin/bash"]
