{
  "maintainer": "SakshiJain0302",
  "package_name": "onnx",
  "language": "Python",
  "github_url": "https://github.com/onnx/onnx",
  "version": "v1.17.0",
  "build_deps": [
    "abseil-cpp:20240116.2",
    "libprotobuf:v4.25.3"
