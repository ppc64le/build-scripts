{
  "maintainer": "shalinib-ibm",
  "package_name": "ollama",
  "language": "Python",
  "wheel_name": "ollama-python-package",
  "v2-enabled": true,
  "github_url": "https://github.com/ollama/ollama",
  "version": "v0.40.11",
  "language": "Python",
  "wheel_build": true,
  "v2-enabled": true,
  "resource_class": "heavy",
  "package_dir": "o/ollama",
  "default_branch": "main",
  "build_script": "ollama.sh",
  "docker_build": true,
  "validate_build_script": true,
  "use_non_root_user": false,
  "v0.40.11": {
    "dir": "ollama_ubi_10",
    "build_script": [
      "ollama_v0.40.11_ubi_9.6.sh",
      "ollama_ubi_10.sh"
    ],
    "base_docker_image": "registry.access.redhat.com/ubi10/ubi:10.0",
    "base_docker_variant": "redhat"
  },
  "*": {
    "build_script": "ollama.sh",
    "base_docker_image": "registry.access.redhat.com/ubi9/ubi:9.6",
    "base_docker_variant": "redhat"
  }
}
