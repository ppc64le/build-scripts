{
  "maintainer": "ira.pandey1@ibm.com",
  "package_name": "opencv-python",
  "language": "Python",
  "github_url": "https://github.com/opencv/opencv-python",
  "version": "93",
  "v2-enabled": true,
  "wheel_build": true,
  "resource_class": "heavy",
  "package_dir": "o/opencv-python",
  "default_branch": "4.x",
  "build_script": "opencv-python.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "build_deps": ["numpy:v2.2.5"],
  "*": {
    "build_script": "opencv-python.sh"
  }
}
