+for i = 1, 100 do
+  local s = "a" .. i
+  tb[s] = i
+end
+local iter
+function iter2(tb, k)
+    if k >= 100 then
+        return nil
+    end
+    return k + 1, tb["a" .. (k + 1)]
+end
+
+function iter(tb, k)
+    -- print("tb = " .. tostring(tb))
+    -- print("key = " .. tostring(k))
+    if k == nil then
+        return iter2, tb, 0
+    end
+    error("bad")
+end
+local total = 0
+for k, v in iter(tb) do
