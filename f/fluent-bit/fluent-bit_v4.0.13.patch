+    |   .endif
+    |   lwzx CARG1, BASE_HI, RB
+    |   .if DUALNUM
+    |     .if ENDIAN_LE
+    |       lwzx CARG3, KBASE, CARG3
+    |     .else
+    |       lwzx CARG3, KBASE, RC
+    |     .endif
