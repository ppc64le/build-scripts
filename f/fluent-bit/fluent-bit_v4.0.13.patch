+  |  li TMP0, LJ_TSTR
+  |   decode_RB8 RB, INS
+  |  stw STR:RC, WORD_LO(CARG3)
+  |   add CARG2, BASE, RB
+  |  stw TMP0, WORD_HI(CARG3)
+  |  b >1
+  |
+  |->vmeta_tsets:
