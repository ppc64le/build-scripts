+local _info = {
+  name =	"DynASM",
+  description =	"A dynamic assembler for code generation engines",
+  version =	"1.5.0",
+  vernum =	 10500,
+  release =	"2021-05-02",
+  author =	"Mike Pall",
+  url =		"https://luajit.org/dynasm.html",
+  license =	"MIT",
+  copyright =	[[
