+        print("value is nil for key " .. tostring(k))
+    end
+    total = total + v
+end
+print("total = " .. total)
+--- out
+total = 5050
+--- err
+[TRACE   1 test.lua:3 loop]
+[TRACE   2 test.lua:24 loop]
