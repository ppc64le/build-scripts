+  |  // NOBARRIER: lj_meta_tset ensures the table is not black.
+  |  ins_next1
+  |.if FPU
+  |   stfd f0, 0(CRET1)
+  |.else
+  |   stw TMP2, 0(CRET1)
+  |   stw TMP3, 4(CRET1)
+  |.endif
+  |  ins_next2
