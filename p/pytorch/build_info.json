{
  "maintainer": "ibm",
  "package_name": "pytorch",
  "wheel_name": "torch",
  "v2-enabled": true,
  "language": "Python",
  "github_url": "https://github.com/pytorch/pytorch",
  "version": "v2.6.0",
  "wheel_build": true,
  "resource_class": "heavy",
  "default_branch": "main",
  "package_dir": "p/pytorch",
  "build_script": "pytorch.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "provides_artifact": "pytorch",
  "auditwheel_exclude": [
    "libc10.so",
    "libtorch.so",
    "libtorch_cpu.so",
    "libtorch_python.so",
    "libshm.so"
  ],
  "build_deps": ["openblas:v0.3.29", "libprotobuf:v26.1", "abseil-cpp:20240116.2", "numpy:v2.2.5"],
  "*": {
    "patches": {
      "PATCH": "https://raw.githubusercontent.com/ppc64le/build-scripts/refs/heads/master/p/pytorch/pytorch_v2.6.0.patch"
    },
    "build_script": "pytorch.sh"
  }
}
