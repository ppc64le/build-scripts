{
  "maintainer": "aastha-sharma2",
  "package_name": "poetry",
  "github_url": "https://github.com/python-poetry/poetry",
  "version": "2.3.3",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "p/poetry",
  "build_script": "poetry.sh",
  "validate_build_script": "true",
  "use_non_root_user": "false",
  "v2-enabled": true,
  "docker_build": false,
  "*": {
    "build_script": "poetry.sh"
  }
}
