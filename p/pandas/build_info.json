{
  "maintainer": "Build Scripts Team",
  "package_name": "pandas",
  "language": "Python",
  "github_url": "https://github.com/pandas-dev/pandas",
  "version": "v2.2.3",
  "v2-enabled": true,
  "wheel_build": true,
  "resource_class": "medium",
  "default_branch": "main",
  "package_dir": "p/pandas",
  "build_script": "pandas.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "provides_artifact": "pandas",
  "build_deps": ["numpy"],
  "v2.*": {
    "build_script": "pandas.sh",
    "patches": {
      "PANDAS_MESON_PATCH": "p/pandas/patches/meson-numpy-include.patch"
    }
  },
  "*": {
    "build_script": "pandas.sh",
    "patches": {
      "PANDAS_MESON_PATCH": "p/pandas/patches/meson-numpy-include-3x.patch"
    }
  }
}
