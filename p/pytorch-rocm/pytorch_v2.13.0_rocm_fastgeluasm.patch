+template <>
+CK_TILE_HOST void FastGeluAsm::operator()<fp32x2_t, fp32x2_t>(fp32x2_t& y, const fp32x2_t& x) const
+{
+    const float c1   = -2.0 * 0.035677f;
+    const float c2   = -2.0 * 0.797885f;
+    const float u0   = x.x * (c1 * x.x * x.x + c2);
+    const float emu0 = exp(u0);
+    y.x              = x.x / (1.f + emu0);
+    const float u1   = x.y * (c1 * x.y * x.y + c2);
+    const float emu1 = exp(u1);
+    y.y              = x.y / (1.f + emu1);
+}
