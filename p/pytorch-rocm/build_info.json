{
  "maintainer": "Ameil Kumar <ameil.kumar@ibm.com>",
  "package_name": "pytorch-rocm",
  "github_url": "https://github.com/pytorch/pytorch.git",
  "version": "v2.13.0",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "p/pytorch-rocm",
  "build_script": "pytorch-rocm_2.13.0_ubi_10.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "wheel_name": "torch-rocm",
  "auditwheel_exclude": [
    "libc10.so",
    "libc10_hip.so",
    "libtorch.so",
    "libtorch_cpu.so",
    "libtorch_hip.so",
    "libtorch_python.so",
    "libshm.so",
    "libaotriton_v2.so"
  ],
  "v2.13.0": {
    "build_script": "pytorch-rocm_2.13.0_ubi_10.sh"
  },
  "*": {
    "build_script": "pytorch-rocm_2.13.0_ubi_10.sh"
  }
}
