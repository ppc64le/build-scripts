diff --git a/meta.yaml b/meta.yaml
new file mode 100755
index 0000000000..d678a6b241
--- /dev/null
+++ b/meta.yaml
@@ -0,0 +1,32 @@
+package:
+  name: NAME
+  version: "VERSION"
+
+source:
+  path: .
+
+build:
+  number: 0
+  string: "py312_0"
+
+  script: |
+    set -ex
+    ls -l
+
+    WHEEL="WHEELFILE"
+    {{ PYTHON }} -m pip install "$WHEEL" --no-deps --ignore-installed -vv
+
+  # critical fixes for ppc64le dynamic linker
+  missing_dso_whitelist:
+    - /lib64/libm.so.6
+    - /lib64/libc.so.6
+    - /lib64/ld64.so.2
+
+requirements:
+  host:
+    - python 3.12
+    - pip
+
+  run:
+    - python >=3.10,<=3.13
+    - libgcc
