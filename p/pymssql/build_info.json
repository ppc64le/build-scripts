    }
  },
  "v2.3.2": {
    "build_script": "pymssql.sh",
    "patches": {
      "PYMSSQL_PATCH": "https://raw.githubusercontent.com/ppc64le/build-scripts/master/p/pymssql/patches/pymssql_v2.3.2.patch"
    }
  },
  "v2.3.4": {
    "build_script": "pymssql.sh",
    "patches": {
      "PYMSSQL_PATCH": "https://raw.githubusercontent.com/ppc64le/build-scripts/master/p/pymssql/patches/pymssql_v2.3.4.patch"
