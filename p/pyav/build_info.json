{
  "maintainer": "IBM",
  "package_name": "PyAV",
  "language": "Python",
  "github_url": "https://github.com/PyAV-Org/PyAV",
  "version": "v13.1.0",
  "wheel_build": true,
  "wheel_name": "av",
  "v2-enabled": true,
  "package_dir": "p/pyav",
  "default_branch": "main",
  "build_script": "pyav.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "build_deps": ["ffmpeg"],
  "*": {
    "build_script": "pyav.sh"
  }
}