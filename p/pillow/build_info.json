{
  "maintainer": "Build Scripts Team",
  "package_name": "pillow",
  "language": "Python",
  "github_url": "https://github.com/python-pillow/Pillow",
  "version": "12.3.0",
  "v2-enabled": true,
  "wheel_build": true,
  "resource_class": "medium",
  "default_branch": "main",
  "build_script": "pillow.sh",
  "package_dir": "p/pillow",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "provides_artifact": "pillow",
  "*": {
    "build_script": "pillow.sh"
  }
}
