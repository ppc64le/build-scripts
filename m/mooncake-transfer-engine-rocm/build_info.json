{
  "maintainer": "Daniel Schenker <daniel.schenker@ibm.com>",
  "package_name": "mooncake-transfer-engine-rocm",
  "github_url": "https://github.com/kvcache-ai/Mooncake",
  "version": "v0.3.13.post1",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "m/mooncake-transfer-engine-rocm",
  "build_script": "mooncake_v0.3.13.post1_rocm_ubi_10.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "wheel_name": "mooncake-transfer-engine-rocm",
  "skip_python_versions": ["3.12", "3.14"],
  "auditwheel_exclude": [
    "libc10.so",
    "libc10_hip.so",
    "libtorch.so",
    "libtorch_cpu.so",
    "libtorch_hip.so",
    "libtorch_python.so",
    "libtorchaudio.so",
    "libtorchvision.so",
    "libhip*",
    "libroc*",
    "libamd*",
    "libMIOpen*",
    "libhsa*",
    "librccl*",
    "libLLVM*",
    "libcamd*",
    "libccolamd*",
    "libcholmod*",
    "libcolamd*",
    "libsuitesparseconfig*",
    "libgoamd*",
    "liboam*",
    "libclang*",
    "libMLIR*",
    "libfftw3*",
    "libgotcha*",
    "libOpenCL*"
  ],
  "*": {
    "build_script": "mooncake_v0.3.13.post1_rocm_ubi_10.sh"
  }
}
