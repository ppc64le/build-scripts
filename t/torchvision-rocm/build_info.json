{
  "maintainer": "Ameil Kumar <ameil.kumar@ibm.com>",
  "package_name": "torchvision-rocm",
  "github_url": "https://github.com/pytorch/vision.git",
  "version": "v0.28.0",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "t/torchvision-rocm",
  "build_script": "torchvision_0.28.0_rocm_ubi_10.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "wheel_name": "torchvision-rocm",
  "skip_python_versions": ["3.12", "3.14"],
  "auditwheel_exclude": [
    "libtorchvision.so",
    "libc10.so",
    "libc10_hip.so",
    "libtorch.so",
    "libtorch_cpu.so",
    "libtorch_hip.so",
    "libtorch_python.so"
  ],
  "v0.28.0": {
    "build_script": "torchvision_0.28.0_rocm_ubi_10.sh"
  },
  "*": {
    "build_script": "torchvision_0.28.0_rocm_ubi_10.sh"
  }
}