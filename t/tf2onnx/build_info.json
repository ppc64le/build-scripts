{
  "maintainer": "kiranNukal",
  "package_name": "tf2onnx",
  "github_url": "https://github.com/onnx/tensorflow-onnx",
  "version": "v1.16.1",
  "build_deps": [
    "libprotobuf"
  ],
  "language": "Python",
  "resource_class": "heavy",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "t/tf2onnx",
  "build_script": "tf2onnx.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "v2-enabled": true,
  "*": {
    "build_script": "tf2onnx.sh"
  }
}
