{
  "maintainer": "Harithanagothu2",
  "package_name": "thrift-cpp",
  "github_url": "https://github.com/apache/thrift",
  "version": "0.21.0",
  "language": "C++",
  "v2-enabled": true,
  "wheel_build": true,
  "resource_class": "medium",
  "package_dir": "t/thrift-cpp",
  "default_branch": "master",
