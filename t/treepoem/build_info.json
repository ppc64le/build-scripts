{
  "maintainer": "aastha-sharma2",
  "package_name": "treepoem",
  "github_url": "https://github.com/adamchainz/treepoem",
  "version": "3.27.1",
  "default_branch": "main",
  "package_dir": "t/treepoem",
  "wheel_build": true,
  "build_script": "treepoem.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "v2-enabled": true,
  "build_deps": ["ghostscript:ghostpdl-10.03.1"],
  "3.24.0": {
    "build_script": "treepoem.sh",
    "build_deps": ["ghostscript:ghostpdl-10.0.0"]
  },
  "*" : {
    "build_script": "treepoem.sh",
    "build_deps": ["ghostscript:ghostpdl-10.03.1"]
  }
}