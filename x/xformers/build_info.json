{
  "maintainer": "bhagyashrigai",
  "package_name": "xformers",
  "github_url": "https://github.com/facebookresearch/xformers",
  "version": "v0.0.29",
  "language": "Python, C++",
  "wheel_build": true,
  "default_branch": "main",
  "package_dir": "x/xformers",
  "build_script": "xformers.sh",
  "resource-class": "heavy",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "auditwheel_exclude": [
    "libc10.so",
    "libtorch.so",
    "libtorch_cpu.so",
    "libtorch_python.so",
    "libshm.so"
  ],
  "build_deps": ["openblas", "pytorch", "libprotobuf", "abseil-cpp", "numpy", "scipy"],
  "v0.0.29 | v0.0.30": {
    "build_deps": [
      "openblas:v0.3.32",
      "pytorch:v2.7.1",
      "libprotobuf:v26.1",
      "abseil-cpp:20240116.2",
      "numpy:v2.2.5",
      "scipy:v1.17.1"
    ],
    "build_script": "xformers.sh"
  },
  "provides_artifact": "xformers",
  "v2-enabled": true,
  "*": {
    "build_script": "xformers.sh"
  }
}