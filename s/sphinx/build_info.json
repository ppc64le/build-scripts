{
  "maintainer": "Anumala Rajesh",
  "package_name": "sphinx",
  "github_url": "https://github.com/sphinx-doc/sphinx",
  "version": "v8.2.3",
  "wheel_build": true,
  "package_dir": "s/sphinx",
  "default_branch": "master",
  "build_script": "sphinx.sh",
  "docker_build": false,
  "validate_build_script": true,
  "v2-enabled": true,
  "use_non_root_user": "false",
  "*": {
    "build_script": "sphinx.sh",
    "patches": {
      "PATCH": "https://raw.githubusercontent.com/ppc64le/build-scripts/master/s/sphinx/patches/coverage-logging.patch"
    }
  }
}
