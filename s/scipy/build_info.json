{
  "maintainer": "Build Scripts Team",
  "package_name": "scipy",
  "language": "Python",
  "github_url": "https://github.com/scipy/scipy",
  "version": "v1.17.1",
  "wheel_build": true,
  "resource_class": "heavy",
  "default_branch": "main",
  "build_script": "scipy.sh",
  "package_dir": "s/scipy",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "provides_artifact": "scipy",
  "v2-enabled": true,
  "build_deps": ["openblas", "numpy:v2.2.5"],
  "v1.13.*": {
    "build_deps": ["openblas", "numpy:v2.2.5"],
    "build_script": "scipy.sh"
  },
  "v1.14.* | v1.15.* | v1.16.* | v1.17.*": {
    "build_deps": ["openblas", "numpy:v2.2.5"],
    "build_script": "scipy.sh",
    "patches": {
      "SCIPY_F2PY_SAFE_PATH_PATCH": "s/scipy/patches/f2py-safe-path.patch"
    }
  },
  "*": {
    "build_deps": ["openblas", "numpy"],
    "build_script": "scipy.sh"
  }
}
