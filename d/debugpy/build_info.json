{
  "maintainer": "Vrusha Naik <Vrusha.Naik@ibm.com>",
  "package_name": "debugpy",
  "language": "Python",
  "github_url": "https://github.com/microsoft/debugpy",
  "version": "v1.8.20",
  "wheel_build": true,
  "package_dir": "d/debugpy",
  "default_branch": "main",
  "build_script": "debugpy.sh",
  "docker_build": false,
  "validate_build_script": true,
  "use_non_root_user": false,
  "v2-enabled": true,
  "build_deps": ["numpy:v2.2.6"],
  "*": {
    "build_script": "debugpy.sh"
  }
}
